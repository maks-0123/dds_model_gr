- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport ctypes\nfrom gnuradio import gr\n\n\
      class blk_dds(gr.sync_block):\n    def __init__(self, lib_path='/Users/maksimromanuta/Documents/work_on_etalon/icarus_DDS/obj_dir_dactest/libdds_dactest.dylib'):\n\
      \        gr.sync_block.__init__(self, name='DDS Verilator',\n              \
      \                 in_sig=[np.int32], out_sig=[np.int32])\n        self.lib =\
      \ ctypes.CDLL(lib_path)\n        self.lib.dds_init()\n\n    def work(self, input_items,\
      \ output_items):\n        x = np.ascontiguousarray(input_items[0], dtype=np.int32)\n\
      \        y = output_items[0]\n        n = min(len(x), len(y))\n        self.lib.dds_run(x.ctypes.data_as(ctypes.c_void_p),\n\
      \                         y.ctypes.data_as(ctypes.c_void_p),\n             \
      \            ctypes.c_int(n))\n        return n"
    affinity: ''
    alias: ''
    comment: ''
    lib_path: '''/Users/maksimromanuta/Documents/work_on_etalon/icarus_DDS/obj_dir_dactest/libdds_dactest.dylib'''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('DDS Verilator', 'blk_dds', [('lib_path', "'/Users/maksimromanuta/Documents/work_on_etalon/icarus_DDS/obj_dir_dactest/libdds_dactest.dylib'")],
      [('0', 'int', 1)], [('0', 'int', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 364.0]
    rotation: 0
    state: enabled
